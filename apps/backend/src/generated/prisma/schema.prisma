generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Form {
  id        String   @id @default(uuid())
  title     String
  sections  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("forms")
}
